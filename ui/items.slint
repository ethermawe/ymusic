import { Theme, Icons, CardItem, TrackRow } from "theme.slint";
import { Label, Icon, IconButton } from "widgets.slint";

export component CardTile inherits Rectangle {
    in property <CardItem> item;
    callback clicked;

    height: 58px;
    border-radius: ta.has-hover ? Theme.radius-md : Theme.radius-sm;
    background: ta.has-hover ? Theme.surface-hi : Theme.surface;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate border-radius { duration: Theme.anim-normal; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Label {
                text: root.item.title;
                font-weight: 600;
                overflow: elide;
            }
            if root.item.subtitle != "" : Label {
                text: root.item.subtitle;
                font-size: 12px;
                color: Theme.muted;
                overflow: elide;
            }
        }

        Label {
            text: "→";
            color: Theme.muted;
        }
    }
}

export component TrackItem inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <bool> current;
    in property <bool> playing;
    callback activate;
    callback toggle-like;
    callback open-artist;
    callback open-album;

    height: 56px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.surface-hi : root.current ? Theme.surface : transparent;
    opacity: track.available ? 1 : 0.45;

    animate background { duration: Theme.anim-fast; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-xs;
                clip: true;
                background: Theme.surface-hi;

                if root.track.has-cover : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.track.cover;
                    image-fit: cover;
                }

                if !root.track.has-cover && !root.current : Icon {
                    width: 18px;
                    height: 18px;
                    commands: Icons.note;
                    fill: Theme.muted;
                }

                if root.current : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: root.track.has-cover ? #00000088 : transparent;
                    Icon {
                        width: 18px;
                        height: 18px;
                        commands: root.playing ? Icons.pause : Icons.play;
                        fill: Theme.accent;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 2;
            min-width: 0px;
            preferred-width: 0px;
            alignment: center;
            spacing: 2px;
            Label {
                min-width: 0px;
                preferred-width: 0px;
                text: root.track.title;
                overflow: elide;
                font-weight: 500;
                horizontal-alignment: left;
                color: root.current ? Theme.accent : Theme.text;
            }
            Rectangle {
                height: 18px;
                min-width: 0px;
                preferred-width: 0px;
                artist-ta := TouchArea {
                    enabled: root.track.has-artist;
                    mouse-cursor: root.track.has-artist ? pointer : default;
                    clicked => { root.open-artist(); }
                }
                Label {
                    width: parent.width;
                    height: parent.height;
                    text: root.track.artists;
                    overflow: elide;
                    font-size: 12px;
                    horizontal-alignment: left;
                    color: artist-ta.has-hover ? Theme.text : Theme.muted;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            album-ta := TouchArea {
                enabled: root.track.album != "" && root.track.has-album;
                mouse-cursor: root.track.album != "" && root.track.has-album ? pointer : default;
                clicked => { root.open-album(); }
            }
            Label {
                width: parent.width;
                height: parent.height;
                text: root.track.album;
                overflow: elide;
                font-size: 12px;
                horizontal-alignment: left;
                color: album-ta.has-hover ? Theme.text : Theme.muted;
            }
        }

        Rectangle {
            width: 42px;
            if root.track.cached : Label {
                width: parent.width;
                height: parent.height;
                text: "кэш";
                font-size: 11px;
                color: Theme.accent;
                horizontal-alignment: right;
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                width: 30px;
                height: 30px;
                icon: root.track.liked ? Icons.heart-fill : Icons.heart-outline;
                active: root.track.liked;
                clicked => { root.toggle-like(); }
            }
        }

        Label {
            width: 44px;
            text: root.track.duration;
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }
}
