export struct TrackRow {
    title: string,
    artists: string,
    album: string,
    duration: string,
    available: bool,
    liked: bool,
    cached: bool,
    has-artist: bool,
    has-album: bool,
    cover: image,
    has-cover: bool,
}

export struct CardItem {
    title: string,
    subtitle: string,
    kind: string, // "playlist" | "album" | "artist"
    cover: image,
    has-cover: bool,
}

export global Theme {
    in-out property <color> bg: #141314;
    in-out property <color> surface-low: #1d1b1c;
    in-out property <color> surface: #211f20;
    in-out property <color> surface-hi: #2b292b;
    in-out property <color> surface-highest: #363436;
    in-out property <color> text: #e7e1e3;
    in-out property <color> muted: #949091;
    in-out property <color> outline: #494648;
    in-out property <color> accent: #d1c2d2;
    in-out property <color> on-accent: #372d3a;
    in-out property <color> secondary-container: #4c444d;
    in-out property <color> on-secondary-container: #ebdfe9;
    in-out property <color> danger: #93000a;
    in-out property <color> on-danger: #ffdad6;

    // Скругления и тайминги M3 Expressive из Swiftify / end4
    out property <length> radius-unsharpen: 2px;
    out property <length> radius-xs: 8px;
    out property <length> radius-sm: 12px;
    out property <length> radius-md: 16px;
    out property <length> radius-lg: 24px;
    out property <length> radius-full: 9999px;
    out property <duration> anim-fast: 150ms;
    out property <duration> anim-normal: 220ms;
}

