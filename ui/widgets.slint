import { Theme, Icons } from "theme.slint";

export component Label inherits Text {
    color: Theme.text;
    vertical-alignment: center;
}

export component Icon inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 0;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> primary;
    in property <bool> morphing;
    in property <bool> active;
    in property <bool> has-dot: false;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: morphing ? (active ? 14px : self.width / 2) : self.width / 2;
    opacity: enabled ? (ta.pressed ? 0.75 : (ta.has-hover ? 0.95 : 1.0)) : 0.4;
    background: morphing
        ? (active
            ? (ta.has-hover ? Theme.on-secondary-container : Theme.accent)
            : (ta.has-hover ? Theme.surface-highest : Theme.secondary-container))
        : primary
            ? (ta.has-hover ? Theme.on-secondary-container : Theme.accent)
            : active
                ? (ta.has-hover ? Theme.surface-highest : Theme.secondary-container)
                : (ta.has-hover ? Theme.surface-hi : transparent);

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate border-radius { duration: Theme.anim-normal; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
    animate opacity { duration: Theme.anim-fast; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Icon {
        width: root.width * 0.55;
        height: root.height * 0.55;
        commands: root.icon;
        fill: root.morphing
            ? (root.active ? Theme.on-accent : Theme.on-secondary-container)
            : root.primary
                ? Theme.on-accent
                : root.active ? Theme.accent : (ta.has-hover ? Theme.text : Theme.muted);
    }

    if root.active && root.has-dot : Rectangle {
        y: root.height - 4px;
        x: (root.width - self.width) / 2;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
}

export component PlayHeroButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled: true;
    callback clicked;

    width: 44px;
    height: 44px;
    border-radius: self.width / 2;
    background: ta.has-hover ? Theme.on-secondary-container : Theme.accent;
    opacity: enabled ? (ta.pressed ? 0.8 : 1.0) : 0.4;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate opacity { duration: Theme.anim-fast; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Icon {
        width: 22px;
        height: 22px;
        commands: root.playing ? Icons.pause : Icons.play;
        fill: Theme.on-accent;
    }
}

export component EqualizerBars inherits Rectangle {
    in property <bool> playing: false;
    in property <color> bar-color: Theme.accent;
    width: 16px;
    height: 14px;

    property <int> step: 0;

    Timer {
        interval: 180ms;
        running: root.playing;
        triggered => {
            if (root.step >= 3) {
                root.step = 0;
            } else {
                root.step += 1;
            }
        }
    }

    HorizontalLayout {
        spacing: 2px;
        alignment: center;

        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 2px;
                height: root.playing ? (root.step == 0 ? 12px : (root.step == 1 ? 4px : (root.step == 2 ? 14px : 7px))) : 3px;
                border-radius: 1px;
                background: root.bar-color;
                animate height { duration: 150ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 2px;
                height: root.playing ? (root.step == 0 ? 5px : (root.step == 1 ? 14px : (root.step == 2 ? 8px : 12px))) : 3px;
                border-radius: 1px;
                background: root.bar-color;
                animate height { duration: 150ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 2px;
                height: root.playing ? (root.step == 0 ? 14px : (root.step == 1 ? 7px : (root.step == 2 ? 12px : 4px))) : 3px;
                border-radius: 1px;
                background: root.bar-color;
                animate height { duration: 150ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 2px;
                height: root.playing ? (root.step == 0 ? 7px : (root.step == 1 ? 11px : (root.step == 2 ? 4px : 13px))) : 3px;
                border-radius: 1px;
                background: root.bar-color;
                animate height { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> accent;
    callback clicked;

    height: 36px;
    border-radius: (accent || active) ? Theme.radius-sm : self.height / 2;
    background: accent
        ? (ta.has-hover ? Theme.on-secondary-container : Theme.accent)
        : active
            ? (ta.has-hover ? Theme.surface-highest : Theme.secondary-container)
            : ta.has-hover ? Theme.surface-hi : transparent;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate border-radius { duration: Theme.anim-normal; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Label {
            text: root.text;
            font-weight: 600;
            color: root.accent
                ? Theme.on-accent
                : root.active
                    ? Theme.on-secondary-container
                    : Theme.muted;
        }
    }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> password;
    in-out property <string> text <=> input.text;
    callback accepted(string);

    height: 38px;
    border-radius: input.has-focus ? Theme.radius-sm : 19px;
    background: input.has-focus ? Theme.surface-highest : Theme.surface-hi;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.accent;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate border-radius { duration: Theme.anim-normal; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        if root.icon != "" : VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                commands: root.icon;
                fill: Theme.muted;
            }
        }
        Rectangle {
            input := TextInput {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(self.text); }
            }
            if input.text == "" : Label {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.muted;
            }
        }
    }
}

// Слайдер в стиле Material 3 StyledSlider из Quickshell:
// разделённая дорожка с зазором вокруг вертикального ползунка-палочки и точкой конца.
export component SeekBar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <bool> live;
    in property <float> scroll-step: 0.0;
    callback changed(float);

    property <bool> dragging: ta.pressed;
    property <float> pointer-pos: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    property <float> smooth-value: clamp(value, 0, 1);
    animate smooth-value {
        duration: root.dragging ? 0ms : (root.live ? 90ms : 60ms);
        easing: linear;
    }
    property <float> shown: dragging ? pointer-pos : smooth-value;
    property <length> handle-gap: 5px;
    property <length> handle-x: self.width * root.shown;
    property <length> left-w: max(0px, root.handle-x - root.handle-gap);
    property <length> right-x: min(self.width, root.handle-x + root.handle-gap);
    property <length> right-w: max(0px, self.width - root.right-x);

    min-height: 22px;
    opacity: enabled ? 1 : 0.4;
    animate opacity { duration: Theme.anim-fast; }

    // Левая заполненная часть дорожки
    if root.left-w > 0px : Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.left-w;
        height: 6px;
        border-top-left-radius: 3px;
        border-bottom-left-radius: 3px;
        border-top-right-radius: Theme.radius-unsharpen;
        border-bottom-right-radius: Theme.radius-unsharpen;
        background: Theme.accent;
        animate background { duration: Theme.anim-fast; }
    }

    // Правая оставшаяся часть дорожки
    if root.right-w > 0px : Rectangle {
        x: root.right-x;
        y: (parent.height - self.height) / 2;
        width: root.right-w;
        height: 6px;
        border-top-left-radius: Theme.radius-unsharpen;
        border-bottom-left-radius: Theme.radius-unsharpen;
        border-top-right-radius: 3px;
        border-bottom-right-radius: 3px;
        background: Theme.secondary-container;
        animate background { duration: Theme.anim-fast; }
    }

    // Точка на конце дорожки (TrackDot из Quickshell StyledSlider)
    if root.shown < 0.97 : Rectangle {
        x: parent.width - 5px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.on-secondary-container;
    }

    // Вертикальный ползунок-палочка (сужается при нажатии, как в StyledSlider.qml)
    Rectangle {
        x: clamp(root.handle-x - self.width / 2, 0px, parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: root.dragging ? 2px : (ta.has-hover ? 4px : 3px);
        height: root.dragging || ta.has-hover ? 20px : 16px;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate width { duration: 120ms; easing: ease-out; }
        animate height { duration: 120ms; easing: ease-out; }
        animate background { duration: Theme.anim-fast; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => {
            if (root.live && self.pressed) {
                root.changed(root.pointer-pos);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.changed(root.pointer-pos);
            }
        }
        scroll-event(e) => {
            if (root.enabled && root.scroll-step > 0 && e.delta-y != 0px) {
                root.changed(clamp(root.value + (e.delta-y > 0px ? root.scroll-step : -root.scroll-step), 0.0, 1.0));
                return accept;
            }
            reject
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <string> badge: "";
    callback clicked;

    height: 40px;
    border-radius: self.height / 2;
    background: active
        ? Theme.secondary-container
        : (ta.has-hover ? Theme.surface-hi : transparent);
    opacity: ta.pressed ? 0.82 : 1.0;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate opacity { duration: Theme.anim-fast; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                commands: root.icon;
                fill: root.active ? Theme.accent : (ta.has-hover ? Theme.text : Theme.muted);
                animate fill { duration: Theme.anim-fast; }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label {
                text: root.text;
                font-size: 13px;
                font-weight: root.active ? 700 : 500;
                color: root.active ? Theme.on-secondary-container : (ta.has-hover ? Theme.text : Theme.muted);
                overflow: elide;
                animate color { duration: Theme.anim-fast; }
            }
        }

        if root.badge != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                border-radius: 9px;
                background: root.active ? Theme.accent : Theme.surface-highest;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Label {
                        text: root.badge;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.active ? Theme.on-accent : Theme.muted;
                    }
                }
            }
        }
    }
}

export component HomeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <bool> accent: false;
    callback clicked;

    height: 60px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.surface-highest : Theme.surface-low;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.outline;
    opacity: ta.pressed ? 0.88 : 1.0;

    animate background { duration: Theme.anim-fast; easing: ease-out; }
    animate border-color { duration: Theme.anim-fast; easing: ease-out; }
    animate opacity { duration: Theme.anim-fast; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: Theme.radius-sm;
                background: root.accent ? Theme.accent : Theme.secondary-container;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            width: 20px;
                            height: 20px;
                            commands: root.icon;
                            fill: root.accent ? Theme.on-accent : Theme.on-secondary-container;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Label {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
                color: Theme.text;
            }
            if root.subtitle != "" : Label {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
    }
}
