#include <windows.h>

IDI_ICON1 ICON "@YMUSIC_WIN_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @YMUSIC_VER_MAJOR@,@YMUSIC_VER_MINOR@,@YMUSIC_VER_PATCH@,0
 PRODUCTVERSION @YMUSIC_VER_MAJOR@,@YMUSIC_VER_MINOR@,@YMUSIC_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "finrixx"
            VALUE "FileDescription", "Yandex Music"
            VALUE "FileVersion", "@YMUSIC_VERSION@"
            VALUE "InternalName", "ymusic-qml"
            VALUE "OriginalFilename", "ymusic-qml.exe"
            VALUE "ProductName", "Yandex Music"
            VALUE "ProductVersion", "@YMUSIC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
